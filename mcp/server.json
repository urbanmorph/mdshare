{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.sathya-sankaran/mdshare",
  "title": "mdshare",
  "description": "Share markdown as a link anyone can comment on and edit, no account. MCP server and CLI.",
  "websiteUrl": "https://mdshare.live",
  "repository": {
    "url": "https://github.com/urbanmorph/mdshare",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://mdshare.live/logo.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://mdshare.live/apple-touch-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "180x180"
      ]
    }
  ],
  "version": "1.7.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "mdshare-mcp",
      "version": "1.6.0",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mdshare.live/mcp"
    }
  ]
}
