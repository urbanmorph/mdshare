---
import Layout from "../../layouts/Layout.astro";
import { renderDocsHtml } from "../../../lib/docs-content";

export const prerender = true;

const docsSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "mdshare API & MCP Documentation",
  "description": "REST API and MCP server reference for mdshare — endpoints, authentication, rate limits, and AI client integration.",
  "url": "https://mdshare.live/docs",
  "mainEntityOfPage": "https://mdshare.live/docs",
  "about": [
    { "@type": "Thing", "name": "REST API" },
    { "@type": "Thing", "name": "Model Context Protocol" },
    { "@type": "Thing", "name": "Markdown sharing" }
  ],
  "proficiencyLevel": "Beginner",
  "isAccessibleForFree": true,
  "inLanguage": "en"
};
---

<Layout
  title="API & MCP Documentation — mdshare"
  description="REST API and MCP server for mdshare. Use with Claude, ChatGPT, Gemini, Cursor, Windsurf, or curl."
  canonical="https://mdshare.live/docs"
>
  <script type="application/ld+json" set:html={JSON.stringify(docsSchema)} />
  <div class="min-h-screen bg-neutral-950">
    <header class="border-b border-neutral-800 px-4 sm:px-8 py-4">
      <div class="max-w-3xl mx-auto flex items-center justify-between">
        <a href="/" class="text-lg font-bold text-white">md<span class="text-indigo-400">share</span></a>
        <span class="text-xs text-neutral-400 bg-neutral-900 px-2 py-1 rounded">Docs</span>
      </div>
    </header>
    <main class="max-w-3xl mx-auto px-4 sm:px-8 py-8 sm:py-12">
      <div class="prose-docs docs-md" set:html={renderDocsHtml()} />
      <div class="flex flex-wrap gap-3 mt-8 pt-8 border-t border-[#222]">
        <a href="/" class="inline-block px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium rounded-lg transition-colors no-underline">Try mdshare &rarr;</a>
        <a href="/share-markdown-with-ai" class="inline-block px-5 py-2.5 bg-neutral-900 hover:bg-neutral-800 border border-neutral-800 text-neutral-300 text-sm font-medium rounded-lg transition-colors no-underline">Use with Claude / MCP</a>
        <a href="/about" class="inline-block px-5 py-2.5 bg-transparent hover:bg-neutral-900 text-neutral-400 hover:text-neutral-200 text-sm font-medium rounded-lg transition-colors no-underline">What is mdshare?</a>
      </div>
    </main>
  </div>
</Layout>
